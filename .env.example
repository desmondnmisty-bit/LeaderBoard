# Maximum allowed score value
MAX_SCORE=1000000

# Minimum allowed score value
MIN_SCORE=0

# Real-time update broadcast interval in milliseconds (30 seconds)
UPDATE_INTERVAL=30000

# Optional Socket.io endpoint path (default: /socket.io)
SOCKET_IO_PATH=/socket.io

# Redis connection string (auto-populated by Railway.io)
REDIS_URL=redis://localhost:6379

# Backend server port
PORT=3001

# Environment mode
NODE_ENV=production

# Enable/disable demo mode with auto-generated players
# Set to false in production
DEMO_MODE=false

# Demo mode interval in milliseconds (default: 10000 = 10 seconds)
DEMO_INTERVAL=10000

# Optional admin API key for DELETE operations (leave empty for open access)
# IMPORTANT: Set a secure key in production!
# Generate with: openssl rand -hex 32
ADMIN_API_KEY=changeme_generate_secure_key

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_SCORE=10
RATE_LIMIT_API=100

# Logging
LOG_LEVEL=info
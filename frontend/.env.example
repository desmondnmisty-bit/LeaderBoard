# Backend API URL
NEXT_PUBLIC_API_URL=http://localhost:3001

# Socket.io server URL (same as API URL typically)
NEXT_PUBLIC_SOCKET_URL=http://localhost:3001

# Environment mode
NODE_ENV=development

# Sentry Error Monitoring (optional)
NEXT_PUBLIC_SENTRY_DSN=
# Theme Customization
NEXT_PUBLIC_PRIMARY_COLOR=#1d4ed8
NEXT_PUBLIC_SECONDARY_COLOR=#64748b
NEXT_PUBLIC_APP_NAME="4 The Win Leaderboard"
NEXT_PUBLIC_LOGO_URL=
NEXT_PUBLIC_FONT_FAMILY='Inter', sans-serif
SENTRY_AUTH_TOKEN=